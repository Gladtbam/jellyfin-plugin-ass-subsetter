<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Condition="'$(PersistenceBaselineDll)' == ''" Include="..\Jellyfin.Plugin.AssSubsetter\Jellyfin.Plugin.AssSubsetter.csproj" />
    <Reference Condition="'$(PersistenceBaselineDll)' != ''" Include="Jellyfin.Plugin.AssSubsetter">
      <HintPath>$(PersistenceBaselineDll)</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageReference Include="Jellyfin.Controller" Version="10.11.9" />
    <PackageReference Include="Jellyfin.Model" Version="10.11.9" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.11" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Win32" Version="8.3.1.5" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" Version="8.3.1.5" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <PackageReference Include="HarfBuzzSharp.NativeAssets.macOS" Version="8.3.1.5" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
